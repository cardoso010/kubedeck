{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kubedeck",
  "version": "0.2.1",
  "identifier": "io.github.cardoso010.kubedeck",
  "build": {
    "beforeDevCommand": "npm run binaries && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run binaries && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kubedeck",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/helm"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RjQ3NUU3MjNCNjlBMUMKUldRY21yWWo1M1gweHhzRmxaMU1ZU0syek5ROFdoR2ZvSytFNXg1OG9FU01SckNGNFd1VEhrVW4K",
      "endpoints": []
    }
  }
}
